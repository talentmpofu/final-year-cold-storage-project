# Email Configuration
# Copy this file to .env and fill in your actual values

# Email service provider (gmail, outlook, yahoo, etc.)
EMAIL_SERVICE=gmail

# Your email address (the sender)
EMAIL_USER=your-email@gmail.com

# Your app-specific password (NOT your regular password)
# For Gmail: Generate at https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-16-character-app-password

# Comma-separated list of recipient emails
# Example: admin@example.com,manager@example.com,alerts@company.com
ALERT_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Alert cooldown in minutes (to prevent spam)
ALERT_COOLDOWN_MINUTES=30

# Inference Provider Configuration
# Options: local or roboflow
INFERENCE_PROVIDER=local

# Local inference bridge (used when INFERENCE_PROVIDER=local)
LOCAL_INFERENCE_URL=http://localhost:5000/detect

# Roboflow inference settings (used when INFERENCE_PROVIDER=roboflow)
ROBOFLOW_API_BASE=https://detect.roboflow.com
ROBOFLOW_API_KEY=your-roboflow-api-key
ROBOFLOW_PROJECT=your-project-slug
ROBOFLOW_VERSION=1
ROBOFLOW_CONFIDENCE=50
ROBOFLOW_OVERLAP=50
